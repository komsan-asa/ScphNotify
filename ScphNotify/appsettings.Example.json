{
  "Database": {
    "Server": "YOUR_DB_HOST",
    "Port": 3306,
    "Database": "hos",
    "UserName": "YOUR_USER",
    "Password": "YOUR_PASSWORD",
    "UseSsl": false,
    "ConnectTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 50
  },

  // สิทธิ์เข้าหน้าตั้งค่าการเชื่อมต่อฐานข้อมูล — ล็อกอินด้วยบัญชี HOSxP (ตาราง opduser)
  // ใช้วิธีเดียวกับโปรแกรม Appoint2020:  loginname = ... AND passweb = MD5(รหัสผ่าน)
  // และสิทธิ์ผู้ดูแลระบบดูจาก opduser.groupname = 'admin'
  //
  //  - PasswordColumns / PasswordModes: คอลัมน์และวิธีเข้ารหัสที่จะลองตามลำดับ (HOSxP ใช้ passweb + MD5)
  //                                     ถ้าบัญชีไม่มีค่าในคอลัมน์ไหน จะข้ามไปคอลัมน์ถัดไปเอง
  //  - AdminGroups                    : กลุ่มที่ถือว่าเป็นผู้ดูแลระบบ
  //  - AccessRightKeyword             : ถ้าใส่ไว้ บัญชีที่ accessright มีข้อความนี้จะเป็นแอดมินด้วย
  //  - AdminLogins                    : รายชื่อที่อนุญาตเพิ่ม ไม่ว่ากลุ่มจะเป็นอะไร เช่น [ "komsan" ]
  //  - AllowHosxpSessionLogin         : แสดงปุ่ม "เข้าด้วยบัญชี HOSxP บนเครื่องนี้" (ต้องกดเอง ไม่เข้าอัตโนมัติ)
  //  - AdminIdleLogoutMinutes         : ออกจากระบบผู้ดูแลอัตโนมัติเมื่อไม่ใช้งานครบกี่นาที (0 = ไม่ออกอัตโนมัติ)
  //
  //  ถ้าต่อฐานข้อมูลไม่ได้จนล็อกอินไม่ได้ ให้เปิดด้วย  ScphNotify.exe --dbconfig
  "Security": {
    "RequireAdminLogin": true,
    "UserTable": "opduser",
    "LoginColumn": "loginname",
    "NameColumn": "name",
    "PasswordColumns": [ "passweb", "password", "passwordx" ],
    "PasswordModes": [ "Md5", "Plain", "Sha1" ],
    "GroupColumn": "groupname",
    "AdminGroups": [ "admin" ],
    "AccessRightColumn": "accessright",
    "AccessRightKeyword": "",
    "AdminLogins": [],
    "AllowHosxpSessionLogin": true,
    "AdminIdleLogoutMinutes": 30
  },

  // LAB Template Hemodialysis — ชุดผล LAB ของผู้ป่วยฟอกไต (เทียบเท่า emr_html/fcontent_lab_hd.php)
  //  - MaxDates : จำนวนครั้ง (คอลัมน์) ล่าสุดที่แสดง — ของเดิมใช้ 10
  //  - Items    : รายการและลำดับที่แสดง เทียบกับ lab_order.lab_items_name_ref (ไม่สนตัวพิมพ์เล็ก-ใหญ่)
  //               แถวที่ไม่มีผลเลยในช่วงที่เลือกจะถูกซ่อนอัตโนมัติ
  //               หมายเหตุ: ลำดับ index 25 และ 41-43 ของหน้าเว็บเดิมยังไม่ทราบชื่อรายการ
  //               (ตัวอย่างที่ได้มาไม่มีผลของผู้ป่วยรายนั้น) ถ้าทราบให้เพิ่มลงในตำแหน่งที่ถูกต้องได้เลย
  "LabHemodialysis": {
    "MaxDates": 10,
    "Items": [
      "HCT", "HGB", "WBC", "PLT.count",
      "Neutrophil", "Lymphocyte", "Eosinophil", "Basophil", "Monocyte",
      "MCV", "MCH",
      "BUN", "Creatinine", "eGFR",
      "Na:Sodium", "K:Potassium", "Cl:Chloride", "ECO2:Carbondioxide",
      "Ca:Calcium", "Po4:Phosphorus",
      "Albumin", "Uric acid", "HbA1C (Glyco.Hb.)", "Blood sugar", "Glob.",
      "SGOT(AST)", "SGPT(ALT)", "Alk.phosphatase",
      "Cholesterol", "Triglycerides", "HDL-Cholesterol", "LDL-Cholesterol",
      "Iron serum", "TIBC", "Ferritin", "%TSAT", "*Parathyroid Hormone",
      "HBs Ag", "HBs Ab", "HCV Ab", "HIV Ab (CLIA Automation)"
    ]
  },

  // หน้า HD/CAPD Care — ข้อมูลกลุ่ม A ที่ดึงจาก HOSxP ได้เลย
  //   HdKeywords / PdKeywords = คำในชื่อรายการค่าบริการ (nondrugitems.name) ที่ถือว่าเป็นการล้างไต
  //   แต่ละโรงพยาบาลตั้งชื่อรายการไม่เหมือนกัน ถ้าไม่พบรอบล้างไตให้เปิดดูชื่อจริงในตาราง nondrugitems
  //   แล้วเติมคำค้นที่นี่ (ไม่ต้อง build ใหม่)
  "Dialysis": {
    "Months": 6,
    "HdKeywords": [ "Hemodialysis", "Haemodialysis", "ฟอกเลือด", "ไตเทียม" ],
    "PdKeywords": [ "CAPD", "APD", "Peritoneal", "ช่องท้อง" ],
    "LabItems": [
      "BUN", "Creatinine", "eGFR",
      "K:Potassium", "Na:Sodium", "ECO2:Carbondioxide",
      "HGB", "HCT", "Albumin",
      "Ca:Calcium", "Po4:Phosphorus", "*Parathyroid Hormone"
    ],
    "DrugKeywords": [
      "EPOETIN", "ERYTHROPOIETIN", "DARBEPOETIN",
      "CALCIUM CARBONATE", "ALUMINIUM HYDROXIDE", "SEVELAMER",
      "CALCITRIOL", "ALFACALCIDOL", "SODAMINT", "SODIUM BICARBONATE",
      "FUROSEMIDE", "FOLIC", "FERROUS", "IRON SUCROSE",
      "AMLODIPINE", "LOSARTAN", "ENALAPRIL", "MANIDIPINE", "METOPROLOL", "DOXAZOSIN"
    ]
  },

  "RefreshSeconds": 5,
  "WidgetTopMost": true
}
